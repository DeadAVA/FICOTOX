# Opcion 1 (URL completa):
# DATABASE_URL=mysql+pymysql://root:TU_PASSWORD@127.0.0.1:3306/ficotox

# Opcion 2 (variables separadas):
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ficotox

FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=true
FLASK_APP=run.py
FLASK_ENV=development



# Security
SECRET_KEY=change-me
JWT_SECRET=change-me-too
JWT_EXPIRES_HOURS=12

# Auth behavior: true = crea usuario Consulta si no existe
MICROSOFT_CLIENT_ID=55507f5d-317b-4f09-9575-8b40601bcbbe
MICROSOFT_TENANT_ID=9ab0789b-a61f-4491-88fb-b8cae4691170
MMICROSOFT_SECRET_KEY=d3a0d8f1-6d37-422b-9ea7-614f4aa24de4
MICROSOFT_ALLOWED_DOMAIN=cicese.mx
FICOTOX_GRAPH_DRIVE_ID=480dcc2b-c19e-4536-9a95-7211b11ebfc6
MICROSOFT_AUTH_ENABLED=true
FICOTOX_GRAPH_ENABLED=true
FICOTOX_GRAPH_BASE_PATH=backups
LOCAL_LOGIN_ENABLED=true


# Frontend origins para CORS. Ejemplos:
# CORS_ORIGINS=http://127.0.0.1:5500
# CORS_ORIGINS=http://localhost:3000
CORS_ORIGINS=*
