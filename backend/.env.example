SECRET_KEY=change-me
JWT_SECRET=change-me-too
JWT_EXPIRES_HOURS=12
LOCAL_LOGIN_ENABLED=true

# SQLite local por defecto. Para MySQL/MariaDB usa DATABASE_URL.
SQLITE_PATH=instance/ficotox.sqlite3
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/ficotox

# Microsoft Entra ID
MICROSOFT_AUTH_ENABLED=false
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=
MICROSOFT_ALLOWED_DOMAIN=cicese.mx

# En desarrollo puede ser "*". En produccion usa el origen exacto del frontend.
CORS_ORIGINS=*
